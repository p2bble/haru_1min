<?xml version="1.0" encoding="utf-8"?>
<!-- 마이크로(1x1) 위젯: 작은 물 진행 링 + 링 안쪽 중앙 "+" 만 (겹침 없음). 탭 = 물 추가 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center">

        <!-- 물 진행 링 (배경) -->
        <ProgressBar
            android:id="@+id/widget_ring"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/water_ring" />

        <!-- 링 안쪽 중앙 "+" (터치영역 40dp, 시각 26dp로 축소해 링이 더 보이게) -->
        <FrameLayout
            android:id="@+id/widget_add_water_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_fab_bg"
                android:gravity="center"
                android:text="+"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </FrameLayout>
    </FrameLayout>

</FrameLayout>
